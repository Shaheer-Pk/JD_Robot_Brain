            <ScriptOnClickDef>
              <Title />
              <Description />
              <EZScript>$x = GetRandomUnique(1, 9)

IF ($x = 1)
  ControlCommand("RGB Animator", AutoPositionAction, "banana")
ELSEIF ($x = 2)
  ControlCommand("RGB Animator", AutoPositionAction, "stripes")
ELSEIF ($x = 3)
  ControlCommand("RGB Animator", AutoPositionAction, "expressions")
ELSEIF ($x = 4)
  ControlCommand("RGB Animator", AutoPositionAction, "spin")
ELSEIF ($x = 5)
  ControlCommand("RGB Animator", AutoPositionAction, "dots")
ELSEIF ($x = 6)
  ControlCommand("RGB Animator", AutoPositionAction, "big-small")
ELSEIF ($x = 7)
  ControlCommand("RGB Animator", AutoPositionAction, "test")
ELSEIF ($x = 8)
  ControlCommand("RGB Animator", AutoPositionAction, "flash")
ELSEIF ($x = 9)
  ControlCommand("RGB Animator", AutoPositionAction, "wink")
ENDIF 
  
sleep(200)</EZScript>
