    <ConfigurationFormV2>
      <FormType>Script</FormType>
      <Title>Init</Title>
      <TopLocation>363</TopLocation>
      <LeftLocation>1694</LeftLocation>
      <Width>179</Width>
      <Height>160</Height>
      <WindowState>Normal</WindowState>
      <GUID>cc8e35bd-62e4-415f-a9cd-26a22897fb9f</GUID>
      <Desktop>0</Desktop>
      <Script>
        <ScriptDefinition>
          <Title />
          <Description />
          <EZScript># This script initializes the JD robot
# This script is called from the Connection control when a connection is established to the
# EZ-B on your JD

# specify the ranges for the servos
# this prevents the servos from ever going past these limits

# Neck
SetServoMin(d1, 70)

# Left Gripper
SetServoMin(d6, 30)
SetServoMax(d6, 90)

# Right Gripper
SetServoMin(d9, 30)
SetServoMax(d9, 90)

# Left Ankle
SetServoMin(d14, 60)
SetServoMax(d14, 120)

# Right Ankle
SetServoMin(d18, 60)
SetServoMax(d18, 120)

# Initialize JD into the initialize frame
# All servos are set to 90 degrees in this frame
ControlCommand("Auto Position", AutoPositionFrameJump, "Calibrate")

# Pause for a tiny bit to ensure the servos have been initialized
sleep(100)

# Begin an animation of his eyes
ControlCommand("RGB Animator", AutoPositionAction, "spin")

# set the speed for JD's head to be a little slower and smoother
servospeed(d0, 3)
servospeed(d1, 3)

# Initialize the movement speed
setSpeed(255)

# start the camera so the user doesn't have to press the start button on the camera
if (!$IsCameraActive)
  ControlCommand("Camera", CameraStart)
endif
</EZScript>
          <BlocklyXML />
          <Javascript />
          <Python />
        </ScriptDefinition>
        <ScriptReportProgress>false</ScriptReportProgress>
        <RoboScratchModule>false</RoboScratchModule>
        <Description />
        <Code />
        <BlocklyXML />
      </Script>
    </ConfigurationFormV2>
    <ConfigurationFormV2>
      <FormType>Script</FormType>
      <Title>Script</Title>
      <TopLocation>699</TopLocation>
      <LeftLocation>1694</LeftLocation>
      <Width>171</Width>
      <Height>154</Height>
      <WindowState>Normal</WindowState>
      <GUID>b759813e-4d1d-4f3c-8383-2bf360173dc0</GUID>
      <Desktop>0</Desktop>
      <Script>
        <ScriptDefinition>
          <Title />
          <Description />
          <EZScript>ControlCommand("EZB_Speaker-Piper-TTS", "SpeakResponse", "Hi")</EZScript>
          <BlocklyXML />
          <Javascript />
          <Python />
        </ScriptDefinition>
        <ScriptReportProgress>false</ScriptReportProgress>
        <RoboScratchModule>false</RoboScratchModule>
        <Description />
        <Code />
        <BlocklyXML />
      </Script>
    </ConfigurationFormV2>
    <ConfigurationFormV2>
      <FormType>Soundboardv4</FormType>
      <Title>Soundboard v4</Title>
      <TopLocation>382</TopLocation>
      <LeftLocation>684</LeftLocation>
      <Width>438</Width>
      <Height>327</Height>
      <WindowState>Normal</WindowState>
      <GUID>7b5b2eb1-7133-4f38-a695-99d988ac3319</GUID>
      <Desktop>0</Desktop>
      <SoundBoardv4>
        <SoundBoardList>
          <SoundBoardv4Config>
            <GUID>637c0f6c-e0ab-42cb-8e07-a5397a9a91f4</GUID>
            <Filename>You Haunt Me.mp3</Filename>
            <ContentsCompressed></ContentsCompressed>
            <Scripts>
              <SoundBoardv4Script>
                <GUID>66eea6c9-4fc6-48bc-ad30-36883dc6ec4c</GUID>
                <SamplePosition>59535</SamplePosition>
                <ScriptDefinition>
                  <Title />
