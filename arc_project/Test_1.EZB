    <ConfigurationFormV2>
      <FormType>Script</FormType>
      <Title>Test</Title>
      <TopLocation>717</TopLocation>
      <LeftLocation>673</LeftLocation>
      <Width>171</Width>
      <Height>154</Height>
      <WindowState>Normal</WindowState>
      <GUID>f99c4d1b-b852-43bd-a27d-bfc0d1387d3e</GUID>
      <Desktop>0</Desktop>
      <Script>
        <ScriptDefinition>
          <Title />
          <Description />
          <EZScript />
          <BlocklyXML />
          <Javascript />
          <Python>import urllib.request
import json
import time
import os
import glob

Audio.stop()

spoken_text = getVar("$BingSpeech")
url = "http://10.7.65.138:8000/brain/chat"
payload = {"text": spoken_text}

encoded_data = json.dumps(payload).encode('utf-8')

req = urllib.request.Request(
    url,
    data=encoded_data,
    headers={'Content-Type': 'application/json'},
    method='POST'
)

try:
    with urllib.request.urlopen(req) as response:
        audio_bytes = response.read()

        # Clean up old response files before writing a new one
        old_files = glob.glob("D:\\ARC JD Project\\temp_jd_response_*.wav")
        for old_file in old_files:
            try:
                os.remove(old_file)
            except Exception:
                pass

        local_path = f"D:\\ARC JD Project\\temp_jd_response_{int(time.time())}.wav"
        with open(local_path, "wb") as f:
            f.write(audio_bytes)

        Audio.playAudioFile(local_path)

except Exception as e:
    print("Python HTTP Error Occurred:", e)</Python>
        </ScriptDefinition>
        <ScriptReportProgress>false</ScriptReportProgress>
        <RoboScratchModule>false</RoboScratchModule>
        <Description />
        <Code />
        <BlocklyXML />
      </Script>
