    <ConfigurationFormV2>
      <FormType>Script</FormType>
      <Title>PointAndTrack</Title>
      <TopLocation>531</TopLocation>
      <LeftLocation>1694</LeftLocation>
      <Width>179</Width>
      <Height>160</Height>
      <WindowState>Normal</WindowState>
      <GUID>50397d4e-cd99-41b6-ad86-6d6e84f307a9</GUID>
      <Desktop>0</Desktop>
      <Script>
        <ScriptDefinition>
          <Title />
          <Description />
          <EZScript># this script will be launched in the camera control
# when an object has been detected
# it will point JD's fingers at the object.
#
# This script will loop while tracking is eanbled
# If tracking is stopped by the camera or the variable is detected
# the script will stop
#
# A tracking type will need to be enabled before
# this script is executed. A tracking type could be
# Color, Multicolor, face, etc...
# Check the ACTIVITIES in the LEARN section of the website
# www.ez-robot.com

:loop

$armX = getservo(d0) * 1
$armY = getservo(d1) * 1.5

if (getservo(d0) &lt; 90)

  # point with his right hand

  servo(d2, 250-$armY)
  servo(d7, 90 - $armX)

  # put left arm down
  servo(d3, 180)

  if (getservo(d9) == 90)
    servo(d9, 60)
  ELSE
    servo(d9, 90)
  endif

ELSE

  # point with his left hand
  servo(d3, -70 + $armY)
  servo(d4, 250 - $armX)

  # put right arm down
  servo(D2, 20)
  servo(d7, 30)

  if (getservo(d6) == 90)
    servo(d6, 60)
  ELSE
    servo(d6, 90)
  endif

endif

if (!$CameraIsTracking)
  halt()
endif

sleep(200)

goto(loop)</EZScript>
          <BlocklyXML />
          <Javascript />
          <Python />
        </ScriptDefinition>
        <ScriptReportProgress>false</ScriptReportProgress>
        <RoboScratchModule>false</RoboScratchModule>
        <Description />
        <Code />
        <BlocklyXML />
      </Script>
    </ConfigurationFormV2>
